{
  "name": "dsh-phone-offscreen",
  "version": "0.3.0",
  "description": "Do-not-disturb mode for a real Android phone: run apps on a hidden virtual display (offscreen) so the phone's own screen is never touched.",
  "keywords": [
    "adb",
    "android",
    "deepseek-harness",
    "do-not-disturb",
    "dsh",
    "dsh-plugin",
    "offscreen",
    "phone-automation",
    "virtual-display"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "assets/",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avoiking/dsh-phone-offscreen.git"
  },
  "homepage": "https://github.com/Avoiking/dsh-phone-offscreen#readme",
  "bugs": {
    "url": "https://github.com/Avoiking/dsh-phone-offscreen/issues"
  },
  "author": "Avoiking"
}
